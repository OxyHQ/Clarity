# Required product database. Clarity does not start without PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/clarity

# API and Oxy identity.
PORT=3001
WEB_URL=http://localhost:3000
OXY_API_URL=https://api.oxy.so

# Public, canonical Alia identity. Runtime requires byte-for-byte equality.
CLARITY_ALIA_AGENT_ID=01a0646a-078f-7642-95ef-439952f4f3f9
ALIA_API_URL=https://api.alia.onl

# Fixed backend service credential public key. Local development reads the
# secret from an untracked .env; production uses a DigitalOcean-managed secret.
OXY_SERVICE_API_KEY=oxy_dk_8c84c74a2656b8f5147d4d0b65fcd0e88c192ce64f465f78
# OXY_SERVICE_API_SECRET=

# Optional product infrastructure.
# REDIS_URL=redis://localhost:6379
# REDIS_CA_CERT=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@clarity.surf

# Logging only.
LOG_LEVEL=debug
