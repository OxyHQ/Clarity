{
  "name": "@clarity/backend",
  "version": "1.0.0",
  "description": "Clarity product API and Alia agent client",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:backfill": "bun src/db/backfill.ts",
    "db:attest-cutover": "bun src/db/attest-cutover.ts",
    "agent:bootstrap-manifest": "bun src/scripts/render-clarity-agent-bootstrap.ts"
  },
  "dependencies": {
    "@clarity/shared-types": "workspace:*",
    "@oxyhq/db": "^0.1.2",
    "@oxyhq/core": "^23.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.27.7",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "drizzle-orm": "0.45.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.43",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
