# Required product database. Clarity does not start without PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/clarity

# API and Oxy identity.
PORT=3001
WEB_URL=http://localhost:3000
OXY_API_URL=https://api.oxy.so

# No Oxy key pair. The backend attests its ECS task role (oxy ADR 0026) and Oxy
# mints its service token; the former OXY_SERVICE_API_KEY/SECRET pair is
# retired, and a process given OXY_SERVICE_API_SECRET refuses to become ready.
# Locally there is no role to attest, so the runtime reports
# `clarity_service_identity_unconfigured`, and the capability catalogue cannot
# register (`/_oxy/mcp` answers 503).

# Extra browser origins allowed to call the public MCP (mcp.clarity.surf/mcp),
# beside chatgpt.com and claude.ai. Comma-separated.
# CLARITY_MCP_ALLOWED_ORIGINS=

# Optional product infrastructure.
# REDIS_URL=redis://localhost:6379
# REDIS_CA_CERT=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Oxy file events (POST /webhooks/oxy/files), the secret Oxy shows once when the
# endpoint is set: console -> Webhooks -> File events (docs/oxy-files.md).
# OXY_FILES_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@clarity.surf

# Logging only.
LOG_LEVEL=debug

# Embeddings for hybrid/semantic search, through @kaana.ai/sdk to
# https://kaana.ai/v1 with the attested service token. Enable only once Kaana
# serves qwen/qwen3-embedding-8b to Clarity; while off, search is lexical
# and chunks are stored unembedded (embedded later, once it is on).
CLARITY_EMBEDDINGS_ENABLED=false

# Enable only on deployed ecosystem activity producers.
OXY_ECOSYSTEM_ACTIVITY_ENABLED=false
