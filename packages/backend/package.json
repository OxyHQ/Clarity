{
  "name": "@clarity/backend",
  "version": "1.0.0",
  "description": "Clarity product API and capability catalogue",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "bun dist/index.js",
    "start:worker": "bun dist/worker.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check src",
    "test": "vitest run",
    "test:bun": "bun test --isolate --path-ignore-patterns='**/*.postgres.test.ts' --path-ignore-patterns='**/*-integration.test.ts' src",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=30 --hot-tables=clarity_search_documents,clarity_search_chunks,clarity_search_rate_limit_buckets,clarity_search_quota_grants,clarity_search_usage_events,clarity_subscriptions",
    "db:backfill": "bun src/db/backfill.ts",
    "db:attest-cutover": "bun src/db/attest-cutover.ts",
    "db:attest-fresh-install": "bun src/db/attest-fresh-install.ts",
    "import:oxy-link-previews": "bun src/scripts/import-oxy-link-previews.ts",
    "places:import": "bun src/scripts/import-geonames-places.ts",
    "images:migrate-to-oxy": "bun src/scripts/migrate-images-to-oxy.ts",
    "images:storage-status": "bun src/scripts/image-storage-status.ts",
    "images:reconcile-references": "bun src/scripts/reconcile-oxy-file-references.ts"
  },
  "dependencies": {
    "@clarity/shared-types": "workspace:*",
    "@kaana.ai/sdk": "1.0.1",
    "@mercaria.co/sdk": "0.6.0",
    "@mozilla/readability": "^0.6.0",
    "@oxy.so/contracts": "4.24.0",
    "@oxy.so/core": "5.4.0",
    "@oxy.so/db": "^1.3.0",
    "@oxy.so/mcp": "1.3.0",
    "@oxy.so/utils": "^1.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.2",
    "esbuild": "^0.27.7",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "linkedom": "^0.18.13",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clarity.surf/sdk": "workspace:*",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.43",
    "@types/bun": "1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
