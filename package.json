{
  "name": "clarity-monorepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Clarity - AI-powered search engine with cited sources",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @clarity/frontend dev -- --clear --tunnel",
    "dev:backend": "bun run --filter @clarity/backend dev",
    "build": "bun run --filter @clarity/shared-types build && bun run --filter @clarity.surf/sdk build && bun run --filter @clarity/backend build && bun run --filter @clarity/frontend build",
    "build:sdk": "bun run --filter @clarity.surf/sdk build",
    "postinstall": "bun run build:shared-types && bun run build:sdk",
    "build:shared-types": "bun run --filter @clarity/shared-types build",
    "build:frontend": "bun run --filter @clarity/shared-types build && bun run --filter @clarity.surf/sdk build && bun run --filter @clarity/frontend build",
    "build:backend": "bun run --filter @clarity/shared-types build && bun run --filter @clarity/backend build",
    "start:frontend": "bun run --filter @clarity/frontend start",
    "start:backend": "bun run --filter @clarity/backend start",
    "check:backend-entrypoints": "bun scripts/check-backend-entrypoints.ts",
    "lint": "biome check .",
    "i18n:check": "oxy-doctor-i18n --ci",
    "doctor:oxy": "oxy-doctor --ci",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "android": "bun run --filter @clarity/frontend android",
    "ios": "bun run --filter @clarity/frontend ios",
    "web": "bun run --filter @clarity/frontend web"
  },
  "keywords": [
    "monorepo",
    "ai",
    "search",
    "expo",
    "api",
    "clarity"
  ],
  "author": "",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.7.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-native-reanimated": "4.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "expo-file-system": "58.0.11",
    "react-native-screens": "4.30.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "expo": "58.0.23",
    "noxcturnal": "0.1.9",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.13",
    "expo-font": "58.0.10",
    "expo-image": "58.0.16",
    "expo-modules-core": "58.0.26",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-babel-transformer": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@oxy.so/core": "7.30.0",
    "@oxy.so/contracts": "6.12.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/protocol": "1.9.0",
    "@oxy.so/services": "14.9.0",
    "@oxy.so/mcp": "1.4.1",
    "@oxy.so/bloom": "17.14.1",
    "react-native-css": "3.1.0-rc.0"
  },
  "dependencies": {
    "@oxy.so/core": "7.30.0",
    "@oxy.so/contracts": "6.12.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "zustand": "^5.0.14"
  }
}
