# Required product database. Clarity does not start without PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/clarity

# API and Oxy identity.
PORT=3001
WEB_URL=http://localhost:3000
OXY_API_URL=https://api.oxy.so

# The real provisioned Clarity bot/agent in Alia. There is deliberately no
# placeholder ID: readiness stays closed until deployment supplies this secret.
# CLARITY_ALIA_AGENT_ID=
ALIA_API_URL=https://api.alia.onl

# Optional product infrastructure.
# REDIS_URL=redis://localhost:6379
# REDIS_CA_CERT=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@clarity.surf

# Logging only.
LOG_LEVEL=debug
