{
  "name": "clarity-monorepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Clarity - AI-powered search engine with cited sources",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @clarity/frontend dev -- --clear --tunnel",
    "dev:backend": "bun run --filter @clarity/backend dev",
    "build": "bun run --filter @clarity/shared-types build && bun run --filter @clarity/backend build && bun run --filter @clarity/frontend build",
    "build:shared-types": "bun run --filter @clarity/shared-types build",
    "build:frontend": "bun run --filter @clarity/shared-types build && bun run --filter @clarity/frontend build",
    "build:backend": "bun run --filter @clarity/shared-types build && bun run --filter @clarity/backend build",
    "start:frontend": "bun run --filter @clarity/frontend start",
    "start:backend": "bun run --filter @clarity/backend start",
    "lint": "bun run --filter '*' lint",
    "android": "bun run --filter @clarity/frontend android",
    "ios": "bun run --filter @clarity/frontend ios",
    "web": "bun run --filter @clarity/frontend web"
  },
  "keywords": [
    "monorepo",
    "ai",
    "search",
    "expo",
    "api",
    "clarity"
  ],
  "author": "",
  "devDependencies": {
    "sst": "^4.17.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "react-native-reanimated": "4.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "57.0.1",
    "expo-file-system": "57.0.1",
    "react-native-screens": "4.25.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "expo": "57.0.6",
    "expo-blur": "57.0.2",
    "expo-constants": "57.0.5",
    "expo-font": "57.0.1",
    "expo-image": "57.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/metro-babel-transformer": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@oxyhq/core": "^23.2.0",
    "@oxyhq/contracts": "^0.40.0",
    "lightningcss": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "dependencies": {
    "@oxyhq/core": "^23.2.0",
    "@oxyhq/contracts": "^0.40.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "zustand": "^5.0.14"
  }
}
